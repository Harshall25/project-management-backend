# MongoDB connection string
MONGODB_URI=mongodb://localhost:27017/project-management-app

# Secret used to sign/verify JWTs. REQUIRED — the server refuses to start
# without it. Use a long, random value in every environment.
JWT_KEY=change_me_to_a_long_random_secret

# Port the HTTP server listens on (optional, defaults to 3000)
PORT=3000
